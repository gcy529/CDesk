<?xml version="1.0" encoding="utf-8"?>
<!-- Dock 按钮：三态都要有实体，否则未选中的按钮就只剩字飘在壁纸上。
     之前普通态是 #00000000（全透明），所以压到亮色壁纸上等于"没框"。
     假毛玻璃：深色半透明填充 + 亮描边。API 16 没有实时模糊，这是能做到的上限；
     好处是任何壁纸（纯白/纯黑）上都稳定可见。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按下：实心蓝 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#994D6BFE" />
            <stroke android:width="2dp" android:color="#FF8AA3FF" />
        </shape>
    </item>

    <!-- 焦点（遥控器）：蓝底 + 亮边 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#664D6BFE" />
            <stroke android:width="2dp" android:color="#FFFFD166" />
        </shape>
    </item>

    <!-- 普通：深色玻璃 + 细亮边 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#590B0F19"
                android:endColor="#330B0F19" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
