<?xml version="1.0" encoding="utf-8"?>
<!-- 统一卡片/行/按钮底板：玻璃面板 + 主题强调色焦点边。
     影视/直播/音乐三模块共用同一规格：16dp 圆角、蓝色焦点、玻璃渐变常态，
     保证任何壁纸上都稳定可见、焦点态一致。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#664D6BFE" />
            <stroke android:width="2dp" android:color="#FF4D6BFE" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#994D6BFE" />
            <stroke android:width="2dp" android:color="#FF8AA3FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D161C2C"
                android:endColor="#26161C2C" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
