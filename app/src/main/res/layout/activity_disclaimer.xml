<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDisclaimer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 小弹窗：整块都能点，点哪都算同意并关掉。遥控器只需要按一次 OK -->
    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_media_card"
        android:padding="24dp"
        android:focusable="true"
        android:clickable="true"
        android:id="@+id/boxDisclaimer">

        <TextView
            android:id="@+id/tvDisclaimerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnAgree"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dock_item"
            android:textColor="@color/text_primary"
            android:text="@string/disclaimer_ok" />
    </LinearLayout>
</FrameLayout>
