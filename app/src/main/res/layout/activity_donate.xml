<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDonate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_base"
    android:padding="26dp"
    android:gravity="center_vertical">

    <!-- 左：文案（TV 玻璃卡片） -->
    <LinearLayout
        style="@style/TVCardStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginRight="26dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/donate_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/donate_body"
            android:textSize="@dimen/text_card_title"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="5dp"
            android:text="@string/donate_note"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/donate_scan_hint"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_pill"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="@string/donate_back"
            android:textSize="@dimen/text_body"
            android:textColor="@color/accent" />
    </LinearLayout>

    <!-- 右：二维码白卡（以后加支付宝就再复制一个同样的 FrameLayout） -->
    <FrameLayout
        style="@style/TVCardStyle"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:background="@drawable/bg_qr_card"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivQrWechat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/donate_qr_desc"
            android:src="@drawable/qr_wechat" />
    </FrameLayout>
</LinearLayout>
