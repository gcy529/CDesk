<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRemote"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remote_title"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnRemoteBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="@string/transfer_back"
            android:textSize="@dimen/text_body"
            android:textColor="@color/accent" />
    </LinearLayout>

    <!-- 左：状态 + 地址 + 启停 + 说明；右：二维码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/TVCardStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRemoteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_idle"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvRemoteAddr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remote_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnRemoteToggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill"
                android:paddingLeft="36dp"
                android:paddingRight="36dp"
                android:text="@string/remote_start"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold"
                android:textColor="@color/accent" />

            <CheckBox
                android:id="@+id/ckRemoteBoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="@string/remote_boot"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/remote_boot_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            style="@style/TVCardStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivRemoteQr"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:padding="8dp"
                android:background="@color/on_accent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/remote_qr_hint" />

            <TextView
                android:id="@+id/tvRemoteQrHint"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/remote_qr_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
