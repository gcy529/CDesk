<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <!-- Beta 警告 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_warn"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_beta_title"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:textColor="@color/warn" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/setup_beta_body"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/warn" />
        </LinearLayout>

        <!-- 第一步 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_step1"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_state_unknown"
            android:textSize="@dimen/text_card_title"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/setup_hint_press_home"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHomeSettings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_pill"
                android:text="@string/setup_open_settings"
                android:textSize="@dimen/text_body"
                android:textColor="@color/accent" />

            <Button
                android:id="@+id/btnRecheck"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:text="@string/setup_recheck"
                android:textSize="@dimen/text_body"
                android:textColor="@color/accent" />
        </LinearLayout>

        <!-- 第二步 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/setup_step2"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvOverlayState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/setup_state_unknown"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:paddingLeft="26dp"
            android:paddingRight="26dp"
            android:text="@string/setup_grant_overlay"
            android:textSize="@dimen/text_body"
            android:textColor="@color/accent" />

        <!-- 底部 -->
        <Button
            android:id="@+id/btnEnter"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_pill"
            android:text="@string/setup_enter"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            android:textColor="@color/accent" />
    </LinearLayout>
</ScrollView>
