<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <LinearLayout
        android:id="@+id/rootSettings"
        style="@style/TVCardStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="26dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvSetVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary" />

        <Button android:id="@+id/btnSetFilter"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="20dp" android:text="@string/settings_filter_on" />

        <Button android:id="@+id/btnSetCore"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/settings_core" />

        <Button android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/wallpaper" />

        <Button android:id="@+id/btnSetLang"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/lang_auto" />

        <Button android:id="@+id/btnSetPlayer"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/settings_player_title" />

        <Button android:id="@+id/btnSetUpdate"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/settings_check_update" />

        <Button android:id="@+id/btnSetDisclaimer"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/disclaimer_title" />

        <Button android:id="@+id/btnSetLog"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="@string/settings_log" />

        <Button android:id="@+id/btnSetBack"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="20dp" android:text="@string/transfer_back" />
    </LinearLayout>
</ScrollView>
