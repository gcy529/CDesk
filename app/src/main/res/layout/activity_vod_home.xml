<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvVodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vod_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVodSearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:textColor="@color/text_primary"
            android:text="@string/vodpg_search"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnVodSource"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:textColor="@color/text_primary"
            android:text="@string/vodpg_source"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVodState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:text="@string/vodpg_loading" />

    <GridView
        android:id="@+id/gridCats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:numColumns="5"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="14dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
