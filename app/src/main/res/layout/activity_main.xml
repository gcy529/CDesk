<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@string/wallpaper" />

    <View
        android:id="@+id/bgTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <View
        android:id="@+id/bgBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textColor="#4D6BFE" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2026-11-07  Saturday"
                    android:textSize="16sp"
                    android:textColor="#8E9BAE" />

                <TextView
                    android:id="@+id/tvWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:textSize="13sp"
                    android:textColor="#8E9BAE" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="深海 · 微光"
                    android:textSize="13sp"
                    android:textColor="#4D6BFE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/desk_hint"
                    android:textSize="11sp"
                    android:textColor="#8E9BAE" />
            </LinearLayout>
        </LinearLayout>

        <!-- 翻页条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPagePrev"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_dock_item"
                android:text="@string/page_prev"
                android:textSize="18sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_apps"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:id="@+id/tvPageDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="● ○ ○"
                    android:textSize="9sp"
                    android:textColor="#4D6BFE" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPageNext"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_dock_item"
                android:text="@string/page_next"
                android:textSize="18sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- 空页提示 -->
        <TextView
            android:id="@+id/tvPageHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="#8E9BAE"
            android:visibility="gone" />

        <!-- 应用网格 -->
        <GridView
            android:id="@+id/gridApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:numColumns="6"
            android:horizontalSpacing="10dp"
            android:verticalSpacing="10dp"
            android:stretchMode="columnWidth"
            android:clipToPadding="false"
            android:listSelector="@android:color/transparent" />

        <!-- 底部按钮：玻璃 Dock（半透明圆角，深浅主题运行时染色） -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:background="@drawable/bg_dock"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPalette"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_dock_item"
                android:text="@string/wallpaper"
                android:textSize="14sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnLang"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.6"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_dock_item"
                android:text="@string/lang_auto"
                android:textSize="13sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnDonate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_dock_item"
                android:text="@string/donate"
                android:textSize="14sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnTransfer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:text="@string/transfer"
                android:textSize="14sp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
