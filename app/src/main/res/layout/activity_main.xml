<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/wallpaper" />

    <View
        android:id="@+id/bgTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <View
        android:id="@+id/bgBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55" />

    <LinearLayout
        android:id="@+id/contentMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingRight="300dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- 顶部滚动条 + 版本号：同一根深色条，版本号不再压在壁纸上 -->
        <LinearLayout
            android:id="@+id/barTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dock"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/tvTicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:textSize="13sp"
                android:textColor="#C7D2E3"
                android:text="@string/ticker_text" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:singleLine="true"
                android:text="@string/app_version"
                android:textSize="12sp"
                android:textColor="#E8EEF7" />
        </LinearLayout>

        <!-- 顶栏：时间/日期/天气固定在左上角深色面板；徽章在右上角，不挡壁纸人物 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_dock"
                android:paddingLeft="16dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textColor="#4D6BFE" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2026-11-07  Saturday"
                    android:textSize="16sp"
                    android:textColor="#F2F6FC" />

                <TextView
                    android:id="@+id/tvWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:textColor="#F2F6FC" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textSize="13sp"
                    android:textColor="#4D6BFE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/desk_hint"
                    android:textSize="11sp"
                    android:textColor="#8E9BAE" />
            </LinearLayout>
        </LinearLayout>

        <!-- 翻页条：按键加大，车机遥控器/方向盘点得中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPagePrev"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/page_prev"
                android:textSize="22sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_apps"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:id="@+id/tvPageDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="● ○ ○"
                    android:textSize="9sp"
                    android:textColor="#4D6BFE" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPageNext"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/page_next"
                android:textSize="22sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- 空页提示 -->
        <TextView
            android:id="@+id/tvPageHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="#8E9BAE"
            android:visibility="gone" />

        <!-- 应用网格 -->
        <GridView
            android:id="@+id/gridApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:horizontalSpacing="10dp"
            android:verticalSpacing="10dp"
            android:stretchMode="columnWidth"
            android:clipToPadding="false"
            android:nextFocusDown="@+id/btnPalette"
            android:listSelector="@android:color/transparent" />

        <!-- 底部按钮：玻璃 Dock（半透明圆角，深浅主题运行时染色）
             车机遥控器按键偏小 → 高度 48dp 提到 56dp，间距拉开；
             整条往屏幕下走，paddingBottom 留大一点不被系统导航条盖 -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:background="@drawable/bg_dock"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPalette"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/wallpaper"
                android:textSize="16sp"
                android:nextFocusUp="@+id/gridApps"
                android:focusable="true" />

            <Button
                android:id="@+id/btnLang"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.6"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/lang_auto"
                android:textSize="15sp"
                android:nextFocusUp="@+id/gridApps"
                android:focusable="true" />

            <Button
                android:id="@+id/btnDonate"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/donate"
                android:textSize="16sp"
                android:nextFocusUp="@+id/gridApps"
                android:focusable="true" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/settings_title"
                android:textSize="16sp"
                android:nextFocusUp="@+id/gridApps"
                android:focusable="true" />

            <Button
                android:id="@+id/btnTransfer"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:textColor="@color/text_primary"
                android:text="@string/transfer"
                android:textSize="16sp"
                android:nextFocusUp="@+id/gridApps"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左下：版本号 + 下载角标；右下：上传角标（传输进行时显示，低调半透明） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|bottom"
        android:layout_marginLeft="48dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStatusDown"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/stat_sys_download"
            android:alpha="0.6"
            android:contentDescription="@string/status_downloading" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivStatusUp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="right|bottom"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/stat_sys_upload"
        android:alpha="0.6"
        android:contentDescription="@string/status_uploading" />
</FrameLayout>
