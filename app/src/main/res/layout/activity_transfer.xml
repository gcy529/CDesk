<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transfer_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="@string/transfer_back"
            android:textSize="13sp"
            android:textColor="#38BDF8" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/transfer_idle"
        android:textSize="14sp"
        android:textColor="#94A3B8" />

    <TextView
        android:id="@+id/tvAddr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text=""
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#38BDF8" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/transfer_hint"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:text="@string/transfer_start"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#38BDF8" />

    <ImageView
        android:id="@+id/ivQr"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="14dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/transfer_qr_hint" />

    <TextView
        android:id="@+id/tvQrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/transfer_qr_hint"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/transfer_log"
        android:textSize="12sp"
        android:textColor="#475569" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#7C8BA1" />
    </ScrollView>
</LinearLayout>
