<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvLiveTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/live_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnLiveApi"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/entry_api" />

    <TextView
        android:id="@+id/tvLiveState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:text="@string/livepg_loading" />

    <GridView
        android:id="@+id/gridLive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:numColumns="5"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="14dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
