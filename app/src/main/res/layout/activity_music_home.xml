<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvMusicTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/music_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnMusicApi"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/entry_api" />

        <Button
            android:id="@+id/btnRadioTest"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/musicpg_test" />

        <Button
            android:id="@+id/btnRadioCn"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/musicpg_radio_cn" />

        <Button
            android:id="@+id/btnRadioIntl"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/musicpg_radio_intl" />

        <Button
            android:id="@+id/btnMusicLocal"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/musicpg_local" />

        <Button
            android:id="@+id/btnJsSearch"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textSize="16sp"
            android:text="@string/musicpg_js"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 花音源搜索框：填了音源地址才显示，不干扰内置电台 -->
    <EditText
        android:id="@+id/etJsSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:hint="@string/musicpg_js_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="16sp"
        android:visibility="gone"
        android:background="@drawable/bg_dock_item"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvMusicState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/lvMusic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:divider="@null"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
