<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.c.launcher">

    <!-- 网络状态 + 网速统计只需要这两个 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 局域网传输需要读 Wi-Fi IP -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 车机 / TV / 盒子没有触摸屏，必须声明为非必需，否则装不上 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Android 11+ 包可见性：只有声明了才能列出其它桌面应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:resizeableActivity="true"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">
        <meta-data android:name="android.max_aspect" android:value="2.4" />
        <meta-data android:name="android.notch_support" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 桌面：HOME + DEFAULT 才能出现在「选择桌面」里 -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- 普通启动 -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".DisclaimerActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".WallpaperSettingsActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".CrashActivity"
            android:exported="false" />

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".DonateActivity"
            android:exported="false"
            android:label="@string/donate" />

        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".TransferActivity"
            android:exported="false"
            android:label="@string/transfer_title" />

        <!-- 影音壳：播放器 + 直播 / 点播 / 音乐 三个导入页（不含任何内容源） -->
        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".PlayerActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".LiveShellActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".VodShellActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:name=".MusicShellActivity"
            android:theme="@style/AppTheme" />

        <!-- foregroundServiceType 只在 targetSdk 34+ 生效，低版本自动忽略 -->
        <service
            android:name=".SpeedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Realtime network speed overlay for desktop replacement" />
        </service>
    </application>
</manifest>
